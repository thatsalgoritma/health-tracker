{
  "name": "personal-health-analytics",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "backend",
    "frontend"
  ],
  "scripts": {
    "lint": "npm run lint:check --workspaces --if-present",
    "test": "npm run test --workspace backend",
    "db:migrate": "npm run prisma:migrate --workspace backend",
    "db:generate": "npm run prisma:generate --workspace backend",
    "format": "prettier --write \"**/*.{ts,tsx,js,json,yml,yaml,md}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,json,yml,yaml,md}\""
  },
  "devDependencies": {
    "prettier": "^3.3.3"
  }
}
